# GolfTrace env example - copy to .env and fill

ENV=development
DEV_AUTH_ENABLED=true
DEV_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001

DATABASE_URL=postgresql+psycopg2://golftrace:golftrace@localhost:5432/golftrace
# For local fallback without postgres:
# DATABASE_URL=sqlite:///./golftrace.db

REDIS_URL=redis://localhost:6379/0

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=golftrace
S3_REGION=us-east-1
S3_USE_SSL=false

# Storage fallback for sandbox/tests
LOCAL_STORAGE_PATH=./.storage

API_HOST=0.0.0.0
API_PORT=8000

# Upload limits
MAX_UPLOAD_SIZE_MB=500
MAX_DURATION_SEC=60
MAX_ANALYSIS_INTERVAL_SEC=15
MAX_LONG_EDGE=3840
MAX_SHORT_EDGE=2160
MAX_FPS=120
ANALYSIS_BUDGET_FRAMES=1800

# Render limits
MAX_EXPORT_WIDTH=1920
MAX_EXPORT_HEIGHT=1080
MAX_EXPORT_FPS=60

# Security
JWT_SECRET=change-me-in-production
SIGNED_URL_EXPIRY_SEC=900

# Quotas
MAX_PROJECTS_PER_USER=100
MAX_STORAGE_PER_USER_GB=10
MAX_CONCURRENT_JOBS_PER_USER=2

# Tracking
DEFAULT_MAX_GAP_MS=100
CAMERA_MODEL=affine

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1
